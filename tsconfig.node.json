{
  "compilerOptions": {
    "composite": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "paths": {
      "@main/*": [
        "./src/main/*"
      ],
      "@preload/*": [
        "./src/preload/*"
      ],
      "@renderer/*": [
        "./src/renderer/src/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ]
    }
  },
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "tests/ui-components.test.ts",
    "tests/editor-initial-form.test.ts",
    "tests/stale-event-error.test.ts",
    "tests/friendly-error.test.ts",
    "tests/time-picker-slots.test.ts",
    "tests/drop-target.test.ts",
    "tests/resize-math.test.ts",
    "tests/i18n-parity.test.ts",
    "tests/layout-allday-events.test.ts",
    "tests/roving-index.test.ts",
    "tests/wheel-navigation.test.ts",
    "tests/account-display.test.ts",
    "tests/time-zones.test.ts",
    "tests/new-event.test.ts",
    "tests/editor-double-save.test.ts",
    "tests/search-result-date.test.ts",
    "tests/context-menu-slot.test.ts",
    "tests/long-event-views.test.ts",
    "tests/slot-drag-select.test.ts",
    "tests/settings-event-length.test.ts",
    "tests/location-suggest-input.test.ts"
  ]
}
